{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/etat-major/task-file.schema.json",
  "title": "État-major task file frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "initiative", "project", "owner", "status"],
  "if": {"properties": {"status": {"const": "done"}}, "required": ["status"]},
  "then": {"required": ["accepted_by", "accepted_on"]},
  "else": {"not": {"anyOf": [{"required": ["accepted_by"]}, {"required": ["accepted_on"]}]}},
  "$defs": {
    "taskId": {
      "oneOf": [{"type": "string", "pattern": "^[0-9]+$"}, {"type": "integer", "minimum": 0}]
    }
  },
  "properties": {
    "id": {
      "description": "Digits only; must equal the filename prefix before the first '-'. Quote or zero-pad it as in the filename.",
      "$ref": "#/$defs/taskId"
    },
    "title": {"type": "string", "minLength": 1},
    "initiative": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {
      "description": "Stored intent statuses. In Progress and Review are derived board columns.",
      "enum": ["draft", "ready", "blocked", "done"]
    },
    "priority": {"type": "integer", "minimum": 1},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "milestone": {"type": "string", "pattern": "^[a-z0-9]+$"},
    "depends_on": {
      "description": "Task IDs in the same project.",
      "type": "array",
      "items": {"$ref": "#/$defs/taskId"}
    },
    "targets": {
      "description": "Code references from the traceability grammar. The loader validates the full path and symbol rules.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(fp:n:[a-zA-Z0-9][^\\s#]*|fp:f:[^/~\\s#][^\\s#]*|trail:[^/~\\s#][^\\s#]*#[^\\s#]+)$"
      }
    },
    "accepted_by": {"type": "string", "pattern": "\\S"},
    "accepted_on": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["pr", "test-run", "release"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
