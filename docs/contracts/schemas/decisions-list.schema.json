{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "data", "issues"],
  "properties": {
    "schema": {"const": "etat-major/decisions-list@1"},
    "ok": {"type": "boolean"},
    "data": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "field", "message", "severity"],
      "properties": {
        "path": {"type": "string"},
        "field": {"type": "string"},
        "message": {"type": "string"},
        "severity": {"enum": ["error", "warning"]}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions", "omitted_issues"],
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "status", "decided_by", "question"],
            "properties": {
              "ref": {"type": "string"},
              "status": {"enum": ["proposed", "approved", "rejected", "postponed", "superseded"]},
              "decided_by": {"anyOf": [{"type": "null"}, {"const": "human"}]},
              "question": {"type": "string"}
            }
          }
        },
        "omitted_issues": {"type": "integer", "minimum": 0}
      }
    }
  },
  "if": {"properties": {"ok": {"const": true}}},
  "then": {
    "properties": {
      "data": {"type": "object"},
      "issues": {"not": {"contains": {"properties": {"severity": {"const": "error"}}}}}
    }
  },
  "else": {
    "properties": {"issues": {"contains": {"properties": {"severity": {"const": "error"}}}}}
  }
}
