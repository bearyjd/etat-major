{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "État-major component model version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "components"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 128
    },
    "components": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?!~)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\s#%:\\\\\\u0000-\\u001f\\u007f-\\u009f⁄∕∖⧵⧶⧸⧹／＼﹨╱╲⟋⟍]+(?:/[^/\\s#%:\\\\\\u0000-\\u001f\\u007f-\\u009f⁄∕∖⧵⧶⧸⧹／＼﹨╱╲⟋⟍]+)*$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "provenance"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonempty"
        },
        "provenance": {
          "enum": [
            "human",
            "ai-generated",
            "inferred",
            "verified"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "pattern": "\\S"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "dependentRequired": {
        "reviewed_by": [
          "reviewed_on"
        ],
        "reviewed_on": [
          "reviewed_by"
        ]
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "paths"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonempty"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/nonempty"
        },
        "paths": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/summary"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
